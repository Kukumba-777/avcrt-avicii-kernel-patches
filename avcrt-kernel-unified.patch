# === AVCRT CVP Rebuild (NEW 2026-06-17) — surgical in-kernel vocproc rebuild ===
--- a/techpack/audio/asoc/msm-pcm-routing-v2.c
+++ b/techpack/audio/asoc/msm-pcm-routing-v2.c
@@ -23584,10 +23584,80 @@
 	return 0;
 }
 
+/*
+ * AVCRT CVP Rebuild --- surgical, in-kernel rebuild of the voice path
+ * (CVP/CVS vocproc) for the active call WITHOUT restarting audioserver.
+ *
+ * The avcrtd voice-changer daemon writes this control after a mid-call audio
+ * accessory swap (e.g. 3.5mm minijack -> USB type-C headset) leaves the signed
+ * ADSP CVP latched onto a stale Tx mic device (the far end then hears a faint
+ * copy of the real, un-pitched voice). Muting codec decimators cannot clear it
+ * because the latch lives inside the CVP, not on a codec Tx path. The only
+ * userspace cure was "setprop ctl.restart audioserver", which on this device
+ * re-enumerates the USB sound card and sends the daemon into a routing
+ * flicker-loop.
+ *
+ * This pair of calls (voc_disable_device + voc_enable_device) is exactly the
+ * sequence the audio HAL itself runs for an in-call device switch: it tears the
+ * vocproc down and rebuilds it, re-sending VSS_IVOCPROC_CMD_SET_DEVICE with the
+ * current Tx port, which flushes the latch. The modem (MVM) call is untouched,
+ * so the call survives and only the CVP/CVS is rebuilt -- no audioserver
+ * restart, no USB re-enumeration.
+ *
+ * Default 0 = no action -> stock behaviour. A non-zero write triggers ONE
+ * rebuild of every active voice session; idle sessions are safely skipped
+ * because voc_disable_device() only acts on a VOC_RUN session and
+ * voc_enable_device() only on the VOC_CHANGE state it leaves behind. The flag
+ * auto-clears so each write re-triggers.
+ */
+static int avcrt_cvp_rebuild_trigger;
+
+static int msm_routing_avcrt_cvp_rebuild_get(struct snd_kcontrol *kcontrol,
+					     struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = avcrt_cvp_rebuild_trigger;
+
+	return 0;
+}
+
+static int msm_routing_avcrt_cvp_rebuild_put(struct snd_kcontrol *kcontrol,
+					     struct snd_ctl_elem_value *ucontrol)
+{
+	static const char * const avcrt_voc_sessions[] = {
+		VOICEMMODE1_NAME, VOICEMMODE2_NAME, VOLTE_SESSION_NAME,
+		VOICE_SESSION_NAME, VOICE2_SESSION_NAME, VOWLAN_SESSION_NAME,
+	};
+	int i;
+
+	avcrt_cvp_rebuild_trigger = ucontrol->value.integer.value[0];
+	if (!avcrt_cvp_rebuild_trigger)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(avcrt_voc_sessions); i++) {
+		uint32_t sid = voc_get_session_id((char *)avcrt_voc_sessions[i]);
+
+		if (!sid)
+			continue;
+
+		voc_disable_device(sid);
+		voc_enable_device(sid);
+		pr_info("AVCRT: CVP rebuild for session '%s' (0x%x)\n",
+			avcrt_voc_sessions[i], sid);
+	}
+
+	/* one-shot trigger: auto-clear so the next write always fires */
+	avcrt_cvp_rebuild_trigger = 0;
+
+	return 0;
+}
+
 static struct snd_kcontrol_new msm_voc_session_controls[] = {
 	SOC_SINGLE_MULTI_EXT("Voc VSID", SND_SOC_NOPM, 0,
 			     0xFFFFFFFF, 0, 1, msm_voc_session_id_get,
 			     msm_voc_session_id_put),
+	SOC_SINGLE_EXT("AVCRT CVP Rebuild", SND_SOC_NOPM, 0, 1, 0,
+		       msm_routing_avcrt_cvp_rebuild_get,
+		       msm_routing_avcrt_cvp_rebuild_put),
 };
 
