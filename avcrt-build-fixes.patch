# avcrt-build-fixes.patch  —  build fixes required to produce a WORKING avicii kernel.
#   1) Makefile           : default BRAND_SHOW_FLAG=oneplus  -> selects qcom_pm8008-regulator-nord
#                           (rear-camera PMIC). Without it the generic driver builds and the REAR
#                           cameras get no power (VREG_READY never set).
#   2) scripts/Makefile.lib: add `-f` to cmd_dtc so strict dtc doesn't abort on lito-mtp-overlay.dtbo
#                           (lets `dtbs` / Image.gz-dtb build).
#   3) kernel/cred.c       : EXPORT_SYMBOL(get_task_cred) so a QCA_CLD_WLAN=m wlan.ko links
#                           (NetHunter qcacld inject uses it). Harmless when WLAN is builtin (=y).
# Apply from the kernel source root:  patch -p1 < avcrt-build-fixes.patch   (or: git apply)
--- a/scripts/Makefile.lib
+++ b/scripts/Makefile.lib
@@ -308,7 +308,7 @@
 quiet_cmd_dtc = DTC     $@
 cmd_dtc = mkdir -p $(dir ${dtc-tmp}) ; \
 	$(CPP) $(dtc_cpp_flags) -x assembler-with-cpp -o $(dtc-tmp) $< ; \
-	$(DTC) -q -O dtb -o $@ -b 0 \
+	$(DTC) -q -f -O dtb -o $@ -b 0 \
 		$(addprefix -i,$(dir $<) $(DTC_INCLUDE)) $(DTC_FLAGS) \
 		-d $(depfile).dtc.tmp $(dtc-tmp) ; \
 	cat $(depfile).pre.tmp $(depfile).dtc.tmp > $(depfile)
--- a/Makefile
+++ b/Makefile
@@ -457,6 +457,14 @@
 GCC_PLUGINS_CFLAGS :=
 CLANG_FLAGS :=
 
+# AVCRT: avicii (OnePlus Nord) MUST build as the "oneplus" brand, otherwise
+# drivers/regulator/Makefile selects the generic qcom_pm8008-regulator instead of
+# qcom_pm8008-regulator-nord and the REAR-camera PMIC (PM8008) never reaches VREG_READY
+# (rear cameras get no power). build.sh/build.py already export this; default it here so
+# ANY build method (bare make, Android Studio, a fresh clone) is correct. `?=` lets an
+# explicit env/cmdline BRAND_SHOW_FLAG override; `export` propagates it to the Kbuild sub-makes.
+export BRAND_SHOW_FLAG ?= oneplus
+
 # ifdef VENDOR_EDIT
 KBUILD_CFLAGS +=   -DVENDOR_EDIT
 KBUILD_CPPFLAGS += -DVENDOR_EDIT
--- a/kernel/cred.c
+++ b/kernel/cred.c
@@ -202,6 +202,7 @@
 	rcu_read_unlock();
 	return cred;
 }
+EXPORT_SYMBOL(get_task_cred);
 
 /*
  * Allocate blank credentials, such that the credentials can be filled in at a
