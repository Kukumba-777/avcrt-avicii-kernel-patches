AVCRT: clean cellular-call voice replace + Image.gz-dtb build fix

Two changes to the avicii (OnePlus Nord / lito) 4.19 kernel:

1. techpack/audio/asoc/codecs/bolero/tx-macro.c
   Add the default-off "AVCRT Dec Mute" mixer control. Its value is a bitmask
   of TX decimators; for each set bit it forces the digital MUTE bit (0x10) in
   BOLERO_CDC_TXn_TX_PATH_CTL. Muting the call's modem-bound decimators removes
   the real voice from the cellular uplink at the codec level, while a separate
   unmuted decimator still feeds the userspace daemon -> the daemon injects the
   pitched voice via incall_music, so the far end hears ONLY the changed voice.
   Default 0 = off = stock behaviour, calls unaffected.

2. scripts/Makefile.lib
   Add -f to the dtc command so the strict dtc does not abort the build on the
   pre-existing lito-mtp-overlay.dtbo ("Input tree has errors"); lets `dtbs` and
   thus the Image.gz-dtb target complete. Harmless for valid dtbs.

Apply from the kernel root with:  patch -p1 < avcrt-kernel.patch   (or git apply)
---
--- a/techpack/audio/asoc/codecs/bolero/tx-macro.c
+++ b/techpack/audio/asoc/codecs/bolero/tx-macro.c
@@ -2395,7 +2395,53 @@
 			tx_macro_dec_mode_get, tx_macro_dec_mode_put),
 };
 
+/*
+ * AVCRT experiment: force the digital MUTE bit (0x10) in TXn_TX_PATH_CTL for a
+ * bitmask of decimators. Unlike the broken "TX_DEC Volume" control (sticks at 256),
+ * this directly drives a codec register we own. Purpose: test whether muting the mic
+ * at the CODEC level gates the cellular modem uplink (if yes -> clean replace is
+ * achievable in our domain; if no -> the mute is downstream in signed ADSP firmware).
+ * Default 0 = off (no decimator forced-muted) -> stock behaviour, calls unaffected.
+ */
+static int avcrt_dec_mute_mask;
+
+static int tx_macro_avcrt_mute_get(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = avcrt_dec_mute_mask;
+	return 0;
+}
+
+static int tx_macro_avcrt_mute_put(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component =
+			snd_soc_kcontrol_component(kcontrol);
+	struct device *tx_dev = NULL;
+	struct tx_macro_priv *tx_priv = NULL;
+	int mask = ucontrol->value.integer.value[0];
+	int i;
+
+	if (!tx_macro_get_data(component, &tx_dev, &tx_priv, __func__))
+		return -EINVAL;
+
+	avcrt_dec_mute_mask = mask;
+	for (i = 0; i < NUM_DECIMATORS; i++) {
+		u16 reg = BOLERO_CDC_TX0_TX_PATH_CTL +
+			  TX_MACRO_TX_PATH_OFFSET * i;
+		u8 val = (mask & (1 << i)) ? 0x10 : 0x00;
+
+		snd_soc_component_update_bits(component, reg, 0x10, val);
+		dev_info(component->dev,
+			 "AVCRT: DEC%d mute=%d (reg 0x%04x bit 0x10)\n",
+			 i, !!(mask & (1 << i)), reg);
+	}
+	return 0;
+}
+
 static const struct snd_kcontrol_new tx_macro_snd_controls[] = {
+	SOC_SINGLE_EXT("AVCRT Dec Mute", SND_SOC_NOPM, 0, 0xFF, 0,
+			tx_macro_avcrt_mute_get, tx_macro_avcrt_mute_put),
 	SOC_SINGLE_SX_TLV("TX_DEC0 Volume",
 			  BOLERO_CDC_TX0_TX_VOL_CTL,
 			  0, -84, 40, digital_gain),

--- a/scripts/Makefile.lib
+++ b/scripts/Makefile.lib
@@ -308,7 +308,7 @@
 quiet_cmd_dtc = DTC     $@
 cmd_dtc = mkdir -p $(dir ${dtc-tmp}) ; \
 	$(CPP) $(dtc_cpp_flags) -x assembler-with-cpp -o $(dtc-tmp) $< ; \
-	$(DTC) -q -O dtb -o $@ -b 0 \
+	$(DTC) -q -f -O dtb -o $@ -b 0 \
 		$(addprefix -i,$(dir $<) $(DTC_INCLUDE)) $(DTC_FLAGS) \
 		-d $(depfile).dtc.tmp $(dtc-tmp) ; \
 	cat $(depfile).pre.tmp $(depfile).dtc.tmp > $(depfile)

# === AVCRT camera-fix lock-in (added 2026-06-10) ===
# Makefile: default BRAND_SHOW_FLAG=oneplus -> builds qcom_pm8008-regulator-nord (rear-cam PMIC).
# kernel/cred.c: EXPORT_SYMBOL(get_task_cred) so QCA_CLD_WLAN=m wlan.ko links (harmless on =y).
--- a/Makefile
+++ b/Makefile
@@ -456,6 +456,14 @@
 KBUILD_LDFLAGS :=
 GCC_PLUGINS_CFLAGS :=
 CLANG_FLAGS :=
+
+# AVCRT: avicii (OnePlus Nord) MUST build as the "oneplus" brand, otherwise
+# drivers/regulator/Makefile selects the generic qcom_pm8008-regulator instead of
+# qcom_pm8008-regulator-nord and the REAR-camera PMIC (PM8008) never reaches VREG_READY
+# (rear cameras get no power). build.sh/build.py already export this; default it here so
+# ANY build method (bare make, Android Studio, a fresh clone) is correct. `?=` lets an
+# explicit env/cmdline BRAND_SHOW_FLAG override; `export` propagates it to the Kbuild sub-makes.
+export BRAND_SHOW_FLAG ?= oneplus
 
 # ifdef VENDOR_EDIT
 KBUILD_CFLAGS +=   -DVENDOR_EDIT
